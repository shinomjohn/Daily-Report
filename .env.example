# ==============================================================================
# ASIANET KERALA OPERATIONS AUTOMATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- CRM Authentication Credentials ---
SOFTCODE_USER=your_softcode_username
SOFTCODE_PWD=your_softcode_password

PREPAID_USER=your_prepaid_username
PREPAID_PWD=your_prepaid_password

# SSL certificate verification for Asianet internal CRM portals
# (Set to false if portal uses internal self-signed SSL certificates)
CRM_SSL_VERIFY=false

# --- Regional Configuration (Multi-Region Support) ---
# Primary region identity can be configured here or in region.json
REGION_CONFIG_PATH=region.json
DEFAULT_REGION_ID=thrissur
DEFAULT_REGION_NAME=Thrissur
TARGET_REGION=Thrissur
PREPAID_REGION=Thrissur

# --- Web Server & API Security ---
# Bearer token for authenticating API requests. Production deployments MUST set this.
WEB_API_TOKEN=your_strong_random_token_here

# Directory retention policies
DATA_RETENTION_HOURS=24
LOG_RETENTION_DAYS=3

# --- Target Excel Master Workbook ---
# Path to the complaint tracker Excel workbook (defaults to data/ or repo root)
TARGET_EXCEL_PATH=Daily Complint Tracker.xls
DOWNLOADS_DIR=C:\Users\YourUser\Downloads

# --- WhatsApp Automation & Dispatch ---
# Comma-separated group display names for automated report dispatch
WHATSAPP_GROUPS=NW Team TCR- REGION,ACSO Management

# Local WhatsApp Bot service (Node.js/Docker bridge, e.g., on localhost:3000)
WHATSAPP_BOT_URL=http://localhost:3000
WHATSAPP_BOT_TOKEN=asianet

# Headless / Interactive Chrome Session Profile for WhatsApp Web (Windows)
# CHROME_USER_DATA_DIR=C:\Users\YourUser\AppData\Local\Google\Chrome\User Data
# CHROME_PROFILE_NAME=Profile 13

# Test phone numbers for direct WhatsApp verification scripts
# TEST_PHONE=919999999999
# PERSONAL_PHONE=919999999999
# OFFICE_PHONE=919999999998

# --- Telegram Control Bot ---
# Create bot with @BotFather on Telegram to obtain bot token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram user IDs permitted to trigger runs and view telemetry (comma-separated integers)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Default Telegram chat ID for automated system alerts
TELEGRAM_DEFAULT_CHAT_ID=

# Test phone number for on-demand dispatch tests from Telegram bot
TELEGRAM_TEST_PHONE=

# Web server URL accessible by Telegram bot for status links
TELEGRAM_WEB_URL=http://127.0.0.1:8201

# Systemd service unit name managed by Telegram bot controls (Linux server deployments)
SYSTEMD_SERVICE_NAME=daily-work-report
SCHEDULER_WATCHDOG_ENABLED=1
